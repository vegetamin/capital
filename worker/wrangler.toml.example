name = "alice-os-ai-proxy"
main = "ai-proxy.js"
compatibility_date = "2026-10-18"
# Required secrets: ALICE_ACCESS_TOKEN; add provider AI secrets as needed.
# Market intelligence: add FRED_API_KEY and TWELVE_DATA_API_KEY as Worker secrets.
# Optional vars: MARKET_SYMBOLS="SPY,EFA,EEM,XLK,XLF,XLE,GLD,USO".
# For a separately licensed normalized feed, set MARKET_FEED_URL and MARKET_FEED_TOKEN.
# Configure ALLOWED_ORIGIN as your exact GitHub Pages HTTPS origin (no trailing slash)
[vars]
ALLOWED_ORIGIN = "https://YOURNAME.github.io"
OPENAI_MODEL = "gpt-4.1-mini"
MARKET_SYMBOLS = "SPY,EFA,EEM,XLK,XLF,XLE,GLD,USO"
